<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HyperOS 3.0 Demo</title>
<style>
:root{--card:rgba(255,255,255,.62);--txt:#111;--sub:#6b6f76;--acc:#3482ff;--page:#e9edf3;--glass:rgba(255,255,255,.55);--appbg:#f3f5f9}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--page:#0b0d12}}
:root[data-theme="dark"]{--page:#0b0d12}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent;user-select:none}
html,body{height:100%}
body{background:var(--page);font-family:"Inter","Segoe UI",Roboto,system-ui,sans-serif;display:flex;align-items:center;justify-content:center;padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
#side{position:fixed;left:24px;top:50%;transform:translateY(-50%);max-width:230px;color:#555;font-size:13px;line-height:1.6}
#side h1{font-size:22px;color:var(--acc);margin-bottom:6px}
@media(max-width:900px){#side{display:none}}
#phone{--card:rgba(255,255,255,.62);--txt:#111;--sub:#6b6f76;--glass:rgba(255,255,255,.55);--appbg:#f3f5f9;position:relative;width:390px;height:min(844px,100vh - 20px);border-radius:48px;border:9px solid #14161a;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.35);color:var(--txt);background:#000}
#phone.dark{--card:rgba(40,42,50,.7);--txt:#f2f3f5;--sub:#9aa0aa;--glass:rgba(30,32,40,.6);--appbg:#101218}
@media(max-width:500px){#phone{width:100vw;height:100vh;border:0;border-radius:0}}
.wall{position:absolute;inset:0;background:url(data:image/jpeg;base64,) center/cover no-repeat;transition:filter .4s}.wall:after{content:'';position:absolute;inset:0;background:linear-gradient(#0005,transparent 25%,transparent 70%,#0004)}
#phone.dark .wall{filter:brightness(.55) saturate(1.1)}
.layer{position:absolute;inset:0;transition:transform .45s cubic-bezier(.2,.8,.2,1),opacity .35s}
#status{position:absolute;top:0;left:0;right:0;height:42px;padding:12px 24px 0;display:flex;justify-content:space-between;font-size:13px;font-weight:600;color:#fff;z-index:50;text-shadow:0 1px 4px rgba(0,0,0,.25)}
#status span{cursor:pointer;padding:0 6px}
#island{position:absolute;top:10px;left:50%;transform:translateX(-50%);z-index:60;background:#000;color:#fff;height:26px;width:92px;border-radius:20px;display:flex;align-items:center;justify-content:center;gap:8px;font-size:12px;overflow:hidden;transition:all .45s cubic-bezier(.3,1.3,.5,1);white-space:nowrap;cursor:pointer}
#island.on{width:178px}#island.big{width:340px;height:92px;border-radius:30px;top:8px;justify-content:space-between;padding:0 18px}
#island .eq{display:none;gap:2px;align-items:flex-end;height:14px}#island.on .eq,#island.big .eq{display:flex}
.eq i{width:3px;background:#5ee3a1;border-radius:2px;animation:eq .8s infinite ease-in-out}.eq i:nth-child(2){animation-delay:.2s}.eq i:nth-child(3){animation-delay:.4s}
@keyframes eq{0%,100%{height:4px}50%{height:14px}}
#isl-big{display:none;flex:1;margin-left:12px;text-align:left}#island.big #isl-big{display:block}#island.big #isl-txt{display:none}
#lock{z-index:30;color:#fff;text-align:center;padding-top:110px}
#lock .time{font-size:92px;font-weight:300;letter-spacing:-3px;line-height:1}
#lock .date{font-size:17px;margin-top:6px;opacity:.9}
#lock .note{position:absolute;left:18px;right:18px;bottom:140px;background:var(--glass);backdrop-filter:blur(22px);border-radius:24px;padding:14px 16px;text-align:left;color:var(--txt);font-size:14px}
#lock .hint{position:absolute;bottom:34px;left:0;right:0;font-size:13px;opacity:.85;animation:bob 2s infinite}
@keyframes bob{50%{transform:translateY(-6px)}}
#home{z-index:10;padding:52px 18px 0}
.widget{background:var(--card);backdrop-filter:blur(24px);border-radius:28px;padding:16px 18px;display:flex;justify-content:space-between;align-items:center;color:var(--txt);margin-bottom:18px}
.widget b{font-size:44px;font-weight:300;letter-spacing:-1px;display:block}.widget small{color:var(--sub);font-size:13px}.widget .ico{font-size:46px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px 6px}
.app{display:flex;flex-direction:column;align-items:center;gap:6px;color:#fff;font-size:11.5px;cursor:pointer;text-shadow:0 1px 4px rgba(0,0,0,.35);transition:transform .15s}
.app:active{transform:scale(.88)}
.ic{width:58px;height:58px;border-radius:19px;display:flex;align-items:center;justify-content:center;font-size:28px;box-shadow:0 6px 14px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.4)}
.dock{position:absolute;bottom:34px;left:14px;right:14px;height:84px;border-radius:32px;background:var(--glass);backdrop-filter:blur(26px);display:flex;justify-content:space-around;align-items:center}
.dock .app{text-shadow:none}.dock .app span{display:none}
.dots{position:absolute;bottom:128px;left:0;right:0;display:flex;justify-content:center;gap:6px}.dots i{width:6px;height:6px;border-radius:50%;background:#fff6}.dots i:first-child{background:#fff;width:16px;border-radius:4px}
#gest{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:120px;height:5px;border-radius:3px;background:#fff;z-index:70;cursor:pointer;box-shadow:0 0 6px #0004}
#phone.inapp #gest{background:var(--txt)}
#appl{z-index:40;background:var(--appbg);transform:scale(.3);opacity:0;pointer-events:none;border-radius:40px;padding-top:50px;overflow:hidden;display:flex;flex-direction:column}
#appl.open{transform:scale(1);opacity:1;pointer-events:auto;border-radius:0}
.ah{padding:6px 22px 10px;font-size:30px;font-weight:700}.ab{flex:1;overflow:auto;padding:0 16px 40px}
.grp{background:var(--card);border-radius:22px;margin-bottom:14px;overflow:hidden;background:var(--glass)}
.row{display:flex;align-items:center;gap:14px;padding:14px 16px;font-size:15px;border-bottom:1px solid #8882;cursor:pointer}.row:last-child{border:0}
.row .ri{width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:17px}.row em{margin-left:auto;font-style:normal;color:var(--sub);font-size:13px}
.sw{margin-left:auto;width:46px;height:28px;border-radius:14px;background:#8885;position:relative;transition:.25s}.sw:after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:.25s}.sw.on{background:var(--acc)}.sw.on:after{left:21px}
.dev{background:linear-gradient(135deg,#3482ff,#8a4fff);color:#fff;border-radius:26px;padding:20px;margin-bottom:14px}.dev b{font-size:22px;display:block}.dev small{opacity:.85}
.calc{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding-top:10px}.calc button{height:62px;border:0;border-radius:22px;font-size:22px;background:var(--glass);color:var(--txt);cursor:pointer}.calc button.o{background:var(--acc);color:#fff}.calc button.g{background:#8883}
#cd{font-size:56px;text-align:right;padding:30px 10px 10px;font-weight:300;min-height:120px;word-break:break-all}
.clk{text-align:center;padding-top:20px}.clk .big{font-size:70px;font-weight:200;font-variant-numeric:tabular-nums}
.pill{display:inline-block;margin:6px;padding:12px 26px;border-radius:30px;border:0;background:var(--acc);color:#fff;font-size:16px;cursor:pointer}.pill.g{background:#8884;color:var(--txt)}
.cover{width:220px;height:220px;margin:20px auto;border-radius:36px;background:linear-gradient(135deg,#ff7a59,#ff2d8a,#6a4cff);display:flex;align-items:center;justify-content:center;font-size:80px;box-shadow:0 20px 40px #0004;transition:transform .4s}.cover.p{transform:scale(1.06)}
#shade,#cc{z-index:55;background:rgba(15,18,28,.55);backdrop-filter:blur(34px);color:#fff;padding:56px 18px 30px;transform:translateY(-102%);overflow:auto}
#shade.show,#cc.show{transform:none}
#cc .tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px}
.tile{aspect-ratio:1;border-radius:24px;background:rgba(255,255,255,.14);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-size:11px;cursor:pointer;transition:.2s}.tile i{font-style:normal;font-size:24px}.tile.on{background:var(--acc)}
.slider{height:58px;border-radius:24px;background:rgba(255,255,255,.14);position:relative;margin-bottom:12px;overflow:hidden}.slider div{position:absolute;inset:0 auto 0 0;background:#fff;opacity:.9;width:70%}.slider span{position:absolute;left:18px;top:17px;color:#222;font-size:18px}
.nt{background:rgba(255,255,255,.16);border-radius:22px;padding:13px 16px;margin-bottom:10px;font-size:14px}.nt small{opacity:.7;display:block;margin-bottom:3px;font-size:12px}
#rec{z-index:45;background:rgba(10,12,20,.6);backdrop-filter:blur(20px);opacity:0;pointer-events:none;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff}
#rec.show{opacity:1;pointer-events:auto}
#rcards{display:flex;gap:16px;overflow-x:auto;width:100%;padding:0 50px;scroll-snap-type:x mandatory}
.rc{flex:0 0 220px;height:400px;border-radius:30px;background:var(--appbg);color:var(--txt);scroll-snap-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;cursor:pointer;font-size:15px}
.rc .ic{width:76px;height:76px;font-size:38px;border-radius:25px}
#dim{position:absolute;inset:0;background:#000;opacity:0;pointer-events:none;z-index:80}
#toast{position:absolute;bottom:90px;left:50%;transform:translateX(-50%) translateY(20px);background:#000c;color:#fff;padding:9px 18px;border-radius:20px;font-size:13px;opacity:0;transition:.3s;z-index:90;pointer-events:none}#toast.s{opacity:1;transform:translateX(-50%)}
#cc{background:rgba(18,22,34,.42);backdrop-filter:blur(40px) saturate(1.5);padding-top:58px}
.cch{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.cch b{font-size:34px;font-weight:600;display:block}.cch small{opacity:.75;font-size:13px}.cci{display:flex;gap:10px}.cci span{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px}
.ccg{display:flex;gap:12px;height:164px;margin-bottom:14px}.ccl{flex:1;display:flex;flex-direction:column;gap:12px}
.bt{flex:1;border-radius:28px;background:rgba(255,255,255,.16);display:flex;align-items:center;gap:10px;padding:0 14px;cursor:pointer;transition:.25s}.bt i{font-style:normal;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:18px}.bt b{font-size:14px;display:block}.bt small{font-size:11px;opacity:.8}.bt.on{background:var(--acc)}.bt.on i{background:rgba(255,255,255,.28)}
.vs{width:64px;border-radius:30px;background:rgba(255,255,255,.16);position:relative;overflow:hidden;touch-action:none}.vs div{position:absolute;left:0;right:0;bottom:0;background:#fff;opacity:.92}.vs span{position:absolute;bottom:14px;left:0;right:0;text-align:center;font-size:20px;mix-blend-mode:normal;filter:grayscale(1) contrast(.6)}
.cbs{display:grid;grid-template-columns:repeat(4,1fr);gap:12px 8px;margin-bottom:14px}.tile{aspect-ratio:auto;background:none;gap:6px}.tile i{width:60px;height:60px;border-radius:50%;background:rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;font-size:24px;transition:.25s}.tile.on i{background:var(--acc)}.tile:active i{transform:scale(.9)}
.media{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.16);border-radius:30px;padding:14px 18px}.media small{display:block;opacity:.75;font-size:12px}.media span{cursor:pointer;font-size:20px}.mc{width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,#ff7a59,#ff2d8a,#6a4cff);display:flex;align-items:center;justify-content:center;font-size:24px}
#pwr{position:absolute;right:-12px;top:190px;width:4px;height:70px;background:#14161a;border-radius:3px;cursor:pointer;z-index:100}@media(max-width:500px){#pwr{display:none}}
</style></head><body>
<div id="side"><h1>HyperOS 3.0</h1>Interactive demo.<br>• Swipe up / click the bar to unlock<br>• Tap the status bar left for notifications, right for Control Center<br>• Open Music to see Hyper Island<br>• Gesture bar: tap = Home, double-tap = Recents</div>
<div id="phone">
<div class="wall"></div>
<div id="status"><span id="sl">9:41</span><span id="sr">5G ▮▮▮ 🔋86%</span></div>
<div id="island"><div class="eq"><i></i><i></i><i></i></div><span id="isl-txt"></span><div id="isl-big"></div></div>
<div id="home" class="layer"><div class="widget"><div><b id="wt">9:41</b><small id="wd">Sunday</small></div><div style="text-align:right"><div class="ico">⛅</div><small>29° Raipur-ish · Partly cloudy</small></div></div><div class="grid" id="grid"></div><div class="dots"><i></i><i></i><i></i></div><div class="dock" id="dock"></div></div>
<div id="appl" class="layer"><div class="ah" id="at"></div><div class="ab" id="ac"></div></div>
<div id="rec" class="layer"><div id="rcards"></div><button class="pill g" id="clr" style="margin-top:20px;color:#fff">Clear all</button></div>
<div id="lock" class="layer"><div class="time" id="lt">9:41</div><div class="date" id="ld"></div>
<div class="note"><b>💬 Messages</b><br>Welcome to HyperOS 3.0 — swipe up to explore.</div><div class="hint">⌃ Swipe up to unlock</div></div>
<div id="shade" class="layer"><div style="display:flex;justify-content:space-between;margin-bottom:14px"><b style="font-size:24px">Notifications</b><span id="nclr" style="cursor:pointer;opacity:.8">Clear</span></div><div id="nl"></div></div>
<div id="cc" class="layer">
<div class="cch"><div><b id="cct">9:41</b><small id="ccd"></small></div><div class="cci"><span id="lockb">🔒</span><span>✎</span><span>⚙</span></div></div>
<div class="ccg"><div class="ccl"><div class="bt on" data-t="wifi"><i>📶</i><div><b>Wi-Fi</b><small>HyperHome_5G</small></div></div><div class="bt on" data-t="data"><i>⇅</i><div><b>Mobile data</b><small>5G · Jio</small></div></div></div>
<div class="vs" id="bv"><div style="height:70%"></div><span>☀️</span></div><div class="vs" id="vv"><div style="height:45%"></div><span>🔊</span></div></div>
<div class="cbs" id="tiles"></div>
<div class="media"><div class="mc">🎧</div><div style="flex:1"><b>Hyper Nights</b><small id="mt">Not playing</small></div><span>⏮</span><span id="mp" style="font-size:26px">▶</span><span>⏭</span></div>
</div>
<div id="gest"></div><div id="dim"></div><div id="toast"></div>
</div>
<script>
const $=s=>document.querySelector(s),P=$('#phone');
const apps=[['Phone','📞','#34c759'],['Messages','💬','#3482ff'],['Camera','📷','#555'],['Gallery','🖼️','#ff7a59'],['Settings','⚙️','#7a7f8a'],['Calculator','🧮','#ff9500'],['Clock','⏰','#222'],['Music','🎵','#ff2d55'],['Themes','🎨','#af52de'],['Weather','🌤️','#32ade6'],['Notes','📝','#ffcc00'],['Files','📁','#5ac8fa'],['Browser','🌐','#30b0c7'],['Security','🛡️','#34c759'],['Store','🛍️','#ff6900'],['Compass','🧭','#8e8e93']];
const dockApps=[0,1,12,2];let recents=[],cur=null,music=false,dark=false;
const mk=(a,i)=>`<div class="app" data-i="${i}"><div class="ic" style="background:${a[2]}">${a[1]}</div><span>${a[0]}</span></div>`;
$('#grid').innerHTML=apps.slice(4).map((a,i)=>mk(a,i+4)).join('');
$('#dock').innerHTML=dockApps.map(i=>mk(apps[i],i)).join('');
function tick(){const d=new Date(),t=d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',hour12:false}),ds=d.toLocaleDateString([],{weekday:'long',month:'long',day:'numeric'});
['#sl','#wt','#lt'].forEach(s=>$(s).textContent=t);$('#ld').textContent=ds;$('#wd').textContent=ds;$('#cct').textContent=t;$('#ccd').textContent=ds}
tick();setInterval(tick,1000);
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('s');clearTimeout(t._);t._=setTimeout(()=>t.classList.remove('s'),1600)}
function island(txt,ms){const i=$('#island');$('#isl-txt').textContent=txt;i.classList.add('on');if(ms)setTimeout(()=>{if(!music)i.classList.remove('on')},ms)}
// states
function unlock(){const l=$('#lock');l.style.transform='translateY(-100%)';l.style.opacity=0;l.style.pointerEvents='none';island('Face unlocked ✓',1500);locked=false}
let locked=true;
function lockIt(){const l=$('#lock');l.style.transform='';l.style.opacity=1;l.style.pointerEvents='auto';locked=true;home()}
function closeAll(){['#shade','#cc'].forEach(s=>$(s).classList.remove('show'));$('#rec').classList.remove('show')}
function home(){closeAll();$('#appl').classList.remove('open');P.classList.remove('inapp');cur=null}
function open(i,el){closeAll();const a=apps[i];cur=i;if(!recents.includes(i))recents.unshift(i);
 if(el){const r=el.getBoundingClientRect(),p=P.getBoundingClientRect();$('#appl').style.transformOrigin=(r.left+r.width/2-p.left)+'px '+(r.top+r.height/2-p.top)+'px'}
 $('#at').textContent=a[0];$('#ac').innerHTML=render(a[0]);P.classList.add('inapp');requestAnimationFrame(()=>$('#appl').classList.add('open'));bind(a[0])}
function render(n){
 if(n=='Settings')return`<div class="dev"><b>Xiaomi 15 Series</b><small>HyperOS 3.0 · Android 16</small></div>
 <div class="grp"><div class="row"><div class="ri" style="background:#3482ff">📶</div>Wi-Fi<div class="sw on"></div></div><div class="row"><div class="ri" style="background:#5856d6">ᛒ</div>Bluetooth<div class="sw on"></div></div><div class="row"><div class="ri" style="background:#222">🌙</div>Dark mode<div class="sw ${dark?'on':''}" id="dm"></div></div></div>
 <div class="grp"><div class="row"><div class="ri" style="background:#ff9500">✨</div>Hyper Island<div class="sw on"></div></div><div class="row"><div class="ri" style="background:#34c759">🔗</div>HyperConnect<em>Ready</em></div><div class="row"><div class="ri" style="background:#ff2d55">🎞️</div>Smooth animations<div class="sw on"></div></div></div>
 <div class="grp"><div class="row"><div class="ri" style="background:#8e8e93">ℹ️</div>OS version<em>OS3.0 (demo)</em></div><div class="row"><div class="ri" style="background:#8e8e93">🔒</div>Security patch<em>2026-09</em></div></div>`;
 if(n=='Calculator')return`<div id="cd">0</div><div class="calc">${['C','±','%','÷','7','8','9','×','4','5','6','−','1','2','3','+','0','.','⌫','='].map(k=>`<button class="${'÷×−+='.includes(k)?'o':'CC±%⌫'.includes(k)&&k!='='?'g':''}">${k}</button>`).join('')}</div>`;
 if(n=='Clock')return`<div class="clk"><div class="big" id="sw">00:00.0</div><button class="pill" id="sb">Start</button><button class="pill g" id="sr2">Reset</button></div>`;
 if(n=='Music')return`<div class="cover" id="cv">🎧</div><div style="text-align:center"><b style="font-size:22px">Hyper Nights</b><div style="color:var(--sub)">Demo Artist</div><button class="pill" id="pp">${music?'⏸ Pause':'▶ Play'}</button></div>`;
 if(n=='Themes')return`<div class="grp"><div class="row">🌅 Aurora<em>Applied</em></div><div class="row">🌊 Ocean Drift</div><div class="row">🌸 Bloom</div></div>`;
 return`<div style="text-align:center;padding-top:80px"><div style="font-size:64px">${apps[cur][1]}</div><p style="color:var(--sub);margin-top:12px">${n} is a placeholder in this demo.<br>Try Settings, Calculator, Clock or Music.</p></div>`}
function bind(n){
 if(n=='Settings'){const d=$('#dm');d&&(d.onclick=()=>setDark(!dark));document.querySelectorAll('.sw').forEach(s=>{if(s.id!='dm')s.onclick=()=>s.classList.toggle('on')})}
 if(n=='Calculator'){let e='';const d=$('#cd');document.querySelectorAll('.calc button').forEach(b=>b.onclick=()=>{const k=b.textContent;
  if(k=='C')e='';else if(k=='⌫')e=e.slice(0,-1);else if(k=='±')e=e.startsWith('-')?e.slice(1):'-'+e;else if(k=='='){try{e=String(+Function('"use strict";return('+e.replace(/×/g,'*').replace(/÷/g,'/').replace(/−/g,'-').replace(/%/g,'/100')+')')().toFixed(8))}catch{e='Error'}}else e+=k;d.textContent=e||'0'})}
 if(n=='Clock'){let t0=0,acc=0,run=false,id;const f=()=>{const ms=acc+(run?Date.now()-t0:0);$('#sw').textContent=String(Math.floor(ms/60000)).padStart(2,0)+':'+String(Math.floor(ms/1000)%60).padStart(2,0)+'.'+Math.floor(ms/100)%10};
  $('#sb').onclick=()=>{if(run){acc+=Date.now()-t0;run=false;clearInterval(id)}else{t0=Date.now();run=true;id=setInterval(f,100)}$('#sb').textContent=run?'Stop':'Start'};$('#sr2').onclick=()=>{acc=0;t0=Date.now();f()}}
 if(n=='Music'){const go=()=>{$('#cv').classList.toggle('p',music);$('#pp').textContent=music?'⏸ Pause':'▶ Play'};go();$('#pp').onclick=()=>{setMusic(!music);go()}}}
function setDark(v){dark=v;P.classList.toggle('dark',v);const d=$('#dm');d&&d.classList.toggle('on',v);$('[data-t=dark]')?.classList.toggle('on',v)}
// tiles
const T=[['bt','ᛒ','Bluetooth',1],['fl','🔦','Torch',0],['dark','🌙','Dark mode',0],['air','✈️','Airplane',0],['rot','🔄','Rotate',1],['dnd','🔕','DND',0],['hot','📡','Hotspot',0],['loc','📍','Location',1],['rec','⏺','Record',0],['bat','🔋','Saver',0],['nfc','💳','NFC',1],['scan','⌖','Scan',0]];
$('#tiles').innerHTML=T.map(t=>`<div class="tile ${t[3]?'on':''}" data-t="${t[0]}"><i>${t[1]}</i>${t[2]}</div>`).join('');
document.querySelectorAll('.tile').forEach(t=>t.onclick=()=>{if(t.dataset.t=='dark')setDark(!dark);else t.classList.toggle('on');toast(t.textContent.trim()+(t.classList.contains('on')?' on':' off'))});
document.querySelectorAll('.bt').forEach(t=>t.onclick=()=>t.classList.toggle('on'));
function vslide(el,cb){el.onpointerdown=e=>{const r=el.getBoundingClientRect(),m=ev=>{const p=Math.max(.05,Math.min(1,1-(ev.clientY-r.top)/r.height));el.firstChild.style.height=p*100+'%';cb(p)};m(e);e.stopPropagation();const u=()=>{removeEventListener('pointermove',m);removeEventListener('pointerup',u)};addEventListener('pointermove',m);addEventListener('pointerup',u)}}
vslide($('#bv'),p=>$('#dim').style.opacity=(1-p)*.6);vslide($('#vv'),p=>{});
function setMusic(v){music=v;const i=$('#island');if(v)island('Hyper Nights');else i.classList.remove('on','big');$('#mp').textContent=v?'⏸':'▶';$('#mt').textContent=v?'Now playing':'Not playing'}
$('#mp').onclick=()=>setMusic(!music);$('#lockb').onclick=()=>lockIt();
const pw=document.createElement('div');pw.id='pwr';pw.onclick=()=>locked?unlock():lockIt();P.appendChild(pw);
// notifications
const N=[['💬 Messages · now','Divyansh: Did you see the new HyperOS demo?'],['🛡️ Security · 5m','Scan complete. No risks found.'],['🌤️ Weather · 1h','Light rain expected this evening.'],['🛍️ Store · 2h','3 apps have updates.']];
const nl=()=>$('#nl').innerHTML=N.length?N.map(n=>`<div class="nt"><small>${n[0]}</small>${n[1]}</div>`).join(''):'<p style="opacity:.6;text-align:center;margin-top:60px">No notifications</p>';nl();
$('#nclr').onclick=()=>{N.length=0;nl()};
// interactions
document.addEventListener('click',e=>{const a=e.target.closest('.app');if(a&&!locked&&!$('#appl').classList.contains('open'))open(+a.dataset.i,a.querySelector('.ic'))});
$('#sl').onclick=()=>{if(locked)return;$('#cc').classList.remove('show');$('#shade').classList.toggle('show')};
$('#sr').onclick=()=>{if(locked)return;$('#shade').classList.remove('show');$('#cc').classList.toggle('show')};
let gt=0;$('#gest').onclick=()=>{if(locked)return unlock();if($('#shade.show,#cc.show'))return closeAll();const n=Date.now();if(n-gt<350){showRec()}else setTimeout(()=>{if(Date.now()-gt>=340&&gt==n)home()},360);gt=n};
$('#lock').onclick=unlock;
// swipe gestures
let y0=null;P.addEventListener('pointerdown',e=>y0=e.clientY);P.addEventListener('pointerup',e=>{if(y0==null)return;const dy=e.clientY-y0;y0=null;
 if(dy<-70){if(locked)unlock();else if($('#shade.show,#cc.show'))closeAll();else if(cur!=null||$('#rec.show'))home()}});
function showRec(){$('#appl').classList.remove('open');$('#rcards').innerHTML=recents.length?recents.map(i=>`<div class="rc" data-i="${i}"><div class="ic" style="background:${apps[i][2]}">${apps[i][1]}</div>${apps[i][0]}</div>`).join(''):'<p>No recent apps</p>';$('#rec').classList.add('show');
 document.querySelectorAll('.rc').forEach(c=>c.onclick=()=>{$('#rec').classList.remove('show');open(+c.dataset.i)})}
$('#clr').onclick=()=>{recents=[];showRec()};
$('#island').onclick=()=>{const i=$('#island');if(!music)return;if(i.classList.toggle('big')){$('#isl-big').innerHTML='<b>Hyper Nights</b><br><small style="opacity:.7">Demo Artist · Now playing</small>'}else i.classList.add('on')};
$('#phone').addEventListener('dblclick',e=>{if(e.target.closest('#home')&&e.target.id=='home'&&!locked)lockIt()});
setTimeout(()=>island('HyperOS 3.0',1800),600);
</script></body></html>
